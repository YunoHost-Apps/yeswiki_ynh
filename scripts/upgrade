#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_app_setting_set_default --key=php_upload_max_filesize --value=500M

alias noooOoOOOOoOoooOoOoooPerm="chown"

ynh_script_progression "Upgrading source files..."

remote_extensions=$(curl -s --connect-timeout 5 https://repository.yeswiki.net/doryphore/packages.json | jq -r '[keys[] | select(startswith("extension-")) | "tools/" + sub("extension-"; "")] | sort | join(" ")' 2>/dev/null)

if [ -z "$remote_extensions" ]; then
    echo "Warning: Could not fetch packages.json, using fallback list."
    noncore_extensions="tools/accountactivationbyemail tools/advancedsearch tools/benevolat tools/ferme tools/fontautoinstall tools/fulltextsearch tools/importer tools/ipblock tools/lms tools/logincas tools/loginldap tools/maintenance tools/multideletepages tools/nextcloudconnector tools/publication tools/qrcode tools/stats tools/tabdyn tools/twolevels tools/webhooks"
else
    noncore_extensions="$remote_extensions"
fi

noncore_extensions="$noncore_extensions tools/yunohost"

cron_pause

if farm_has_wikis; then
  farm_park
fi

data_dir_link

ferme_instances=$(
  cd $install_dir
  for p in $(ls -- */wakka.config.php 2>/dev/null); do dirname -- "$p"; done
)
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep=".env wakka.config.php custom themes $noncore_extensions $ferme_instances"

data_dir_link

ynh_replace --match="yeswiki_release' \?=> \?'.*',$" --replace="yeswiki_release' => '$(ynh_app_upstream_version)'," --file="$install_dir/wakka.config.php"

ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

if [ -z "${with_sftp:-}" ]; then
	with_sftp=0
	ynh_app_setting_set --app=$app --key=with_sftp --value=$with_sftp
  ynh_app_setting_set --app=$app --key=password --value=""
fi

if [ -z "${with_app_importer:-}" ]; then
  if grep -qE "'yunohost-(cli|apps)'" "$install_dir/wakka.config.php"; then
    with_app_importer=1
  else
    with_app_importer=0
  fi
  ynh_app_setting_set --app=$app --key=with_app_importer --value=$with_app_importer
fi

ynh_script_progression "Installing Composer dependencies..."

ynh_composer_exec install --no-dev

chown -R $app:www-data "$install_dir"
shopt -s expand_aliases
noooOoOOOOoOoooOoOoooPerm root:root "$install_dir"
setfacl -m g:$app:r-x "$install_dir"
setfacl -m g:www-data:r-x "$install_dir"
chmod 750 "$install_dir"

ynh_script_progression "Upgrading YunoHost plugin..."

cache_yunohost_version

ynh_safe_rm "$install_dir/tools/yunohost"
mkdir -p "$install_dir/tools/yunohost"
ynh_setup_source --dest_dir="$install_dir/tools/yunohost" --source_id="yunohostplugin"

ynh_safe_rm "$install_dir/tools/importer"
mkdir -p "$install_dir/tools/importer"
ynh_setup_source --dest_dir="$install_dir/tools/importer" --source_id="importerplugin"

chmod +x $install_dir/tools/yunohost/private/scripts/*.sh

ynh_config_add --template="sudoers" --destination="/etc/sudoers.d/$app"
noooOoOOOOoOoooOoOoooPerm root:root /etc/sudoers.d/$app

if [ $with_app_importer -eq 1 ]; then
  app_importer_hooks_add
else
  app_importer_hooks_remove
fi

mkdir -p /etc/yunohost/hooks.d/post_user_create
chmod 700 /etc/yunohost/hooks.d/post_user_create
ynh_config_add --template="sync_user_importer.sh" --destination="/etc/yunohost/hooks.d/post_user_create/${app}_sync_user_importer.sh"
noooOoOOOOoOoooOoOoooPerm root:root /etc/yunohost/hooks.d/post_user_create/${app}_sync_user_importer.sh
chmod 700 /etc/yunohost/hooks.d/post_user_create/${app}_sync_user_importer.sh

mkdir -p /etc/yunohost/hooks.d/post_user_delete
chmod 700 /etc/yunohost/hooks.d/post_user_delete
ynh_config_add --template="sync_user_importer.sh" --destination="/etc/yunohost/hooks.d/post_user_delete/${app}_sync_user_importer.sh"
noooOoOOOOoOoooOoOoooPerm root:root /etc/yunohost/hooks.d/post_user_delete/${app}_sync_user_importer.sh
chmod 700 /etc/yunohost/hooks.d/post_user_delete/${app}_sync_user_importer.sh

sso_domain_config "$domain"

if grep -q yunohost-cli "$install_dir/wakka.config.php"; then
  ynh_replace --match="'yunohost-cli'" --replace="'yunohost-apps'" --file="$install_dir/wakka.config.php"
fi

ynh_replace --match="php " --replace="php${php_version} " --file="$install_dir/yeswicli"

if [ $with_app_importer -eq 1 ]; then
  app_importer_config_add
  ynh_script_progression "Import YunoHost apps in bazar"
  app_importer_sync
else
  app_importer_config_remove
fi

ynh_script_progression "Configure mail sending through YunoHost"
mail_config_run add "$app" "$domain"

ynh_script_progression "Configuring the SSO headers..."
sso_headers_config

chown -R $app:www-data "$install_dir"

ynh_script_progression "Putting the farm wikis' files back..."
farm_unpark

if farm_has_wikis; then
  ynh_script_progression "Upgrading the extensions of the farm..."
  farm_upgrade_master_extensions
fi

pushd $install_dir
  ynh_exec_as_app env YESWIKI_FERME_MIGRATING=1 ./yeswicli migrate
popd

if farm_has_wikis; then
  ynh_script_progression "Updating the farm wikis..."
  farm_update_wikis
fi

cron_resume

ynh_script_progression "Upgrade of $app completed"
